{
  "name": "mcp-qa-assistant",
  "version": "0.1.0",
  "description": "MCP server that gives AI assistants QA tools: read Playwright reports, triage failures, draft bug reports",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "author": "Mariya Tony Konikkara",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "private": true,
  "bin": {
    "mcp-qa-assistant": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
